# Only for running on your own computer without Docker (run_local.sh). Do NOT copy these into Railway:
# the database location there is set as explained in README ("Railway").
# WARRAQ_DB=./backend/data/warraq.db   # default when unset: backend/data/warraq.db
AUTO_IMPORT=1
IMPORT_LIMIT=0
# IMPORT_LANGS=en,ar,fr
PORT=8000

# Railway (free plan) - put these in the service's Variables instead:
# DB_URL=https://github.com/aliabbas1111/warraq-fullstack/releases/download/data-v4/warraq-books.db.gz
# WARRAQ_DB=/app/cache/warraq.db
# STATS_DB=/data/stats.db
# RAILWAY_RUN_UID=0
# FORWARDED_ALLOW_IPS=*
# ADMIN_PASSWORD=...        # opens /admin/messages (the contact form's messages); unset = no such page
# CONTACT_EMAIL=...         # only to show another address than alwarraqibrary@gmail.com on /contact
